{
  "oneOf": [
    {
      "type": "object",
      "required": [
        "problems"
      ],
      "properties": {
        "problems": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "tier"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "tier": {
                "enum": [
                  "practice",
                  "expert",
                  "frontier",
                  "existential"
                ]
              }
            }
          }
        }
      }
    },
    {
      "type": "object",
      "required": [
        "tasks",
        "version"
      ],
      "properties": {
        "tasks": {
          "type": "array",
          "minItems": 1
        },
        "version": {
          "type": "string"
        }
      }
    }
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chapelgate.github.io/agent-stopover-experiment/schemas/challenge.schema.json"
}
