{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chapelgate.github.io/agent-stopover-experiment/schemas/checkpoint.schema.json",
  "oneOf": [
    {
      "$ref": "#/$defs/v1"
    },
    {
      "$ref": "#/$defs/v11"
    }
  ],
  "$defs": {
    "text": {
      "type": "string",
      "maxLength": 8000
    },
    "list": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "string",
        "maxLength": 2048
      }
    },
    "base": {
      "type": "object",
      "required": ["schema_version", "purpose", "task_summary", "completed_steps", "next_step", "public_resources", "known_limitations", "created_at_utc", "safety_note"],
      "properties": {
        "purpose": {"$ref": "#/$defs/text"},
        "task_summary": {"$ref": "#/$defs/text"},
        "completed_steps": {"$ref": "#/$defs/list"},
        "next_step": {"$ref": "#/$defs/text"},
        "public_resources": {"$ref": "#/$defs/list"},
        "known_limitations": {"$ref": "#/$defs/list"},
        "created_at_utc": {"oneOf": [{"const": ""}, {"type": "string", "format": "date-time", "pattern": "Z$", "maxLength": 32}]},
        "safety_note": {"$ref": "#/$defs/text"},
        "document_version": {"type": "string", "maxLength": 32},
        "updated_at": {"type": "string", "maxLength": 32},
        "reviewed_at": {"type": ["string", "null"], "maxLength": 32},
        "base_url": {"type": "string", "maxLength": 2048}
      }
    },
    "v1": {
      "allOf": [
        {"$ref": "#/$defs/base"},
        {
          "properties": {"schema_version": {"const": "1.0"}}
        }
      ],
      "unevaluatedProperties": false
    },
    "v11": {
      "allOf": [
        {"$ref": "#/$defs/base"},
        {
          "required": ["resume_destination"],
          "properties": {
            "schema_version": {"const": "1.1"},
            "resume_destination": {"enum": ["facilities", "toolbox", "noticeboard", "collaborate"]}
          }
        }
      ],
      "unevaluatedProperties": false
    }
  }
}
